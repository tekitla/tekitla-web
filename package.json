{
  "name": "tekitla-web",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:qa": "ng build --configuration qa",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run format:check && npm run typecheck",
    "deploy:qa": "npm run build:qa && npx firebase-tools@15 deploy --only hosting --project qa",
    "deploy:prod": "npm run build:prod && npx firebase-tools@15 deploy --only hosting --project production"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ngx-translate/core": "^17.0.0",
    "@tekitla/tekitla-protos": "0.2.0",
    "@vrojas1015/vrb": "0.2.0",
    "firebase": "^12.9.0",
    "marked": "^16.4.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.10.5",
    "jsdom": "^27.1.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
